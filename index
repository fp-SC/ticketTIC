<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Avisos TIC - Sagrado Corazón A.P.P.</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Vue 3 -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <!-- Iconos Phosphor -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <!-- Google Identity Services -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>

    <style>
        [v-cloak] { display: none; }
        body { 
            font-family: 'Inter', system-ui, -apple-system, sans-serif; 
            background-color: #03060f; 
        }
        .spinner { animation: spin 1s linear infinite; }
        @keyframes spin { 100% { transform: rotate(360deg); } }
        
        /* Efectos de brillo ambiental corporativo */
        .bg-glow-red {
            filter: blur(140px);
            background: radial-gradient(circle, rgba(223, 26, 26, 0.15) 0%, rgba(0,0,0,0) 70%);
        }
        .bg-glow-blue {
            filter: blur(140px);
            background: radial-gradient(circle, rgba(2, 84, 199, 0.15) 0%, rgba(0,0,0,0) 70%);
        }
        .bg-glow-gold {
            filter: blur(140px);
            background: radial-gradient(circle, rgba(234, 179, 8, 0.08) 0%, rgba(0,0,0,0) 70%);
        }
    </style>
</head>
<body class="text-slate-100 antialiased p-3 md:p-6 bg-[#03060f] min-h-screen relative overflow-x-hidden">

    <!-- Brillantez ambiental corporativa -->
    <div class="absolute top-10 left-10 w-[350px] h-[350px] bg-glow-blue pointer-events-none -z-10"></div>
    <div class="absolute bottom-10 right-10 w-[400px] h-[400px] bg-glow-red pointer-events-none -z-10"></div>
    <div class="absolute top-1/2 left-1/3 w-[300px] h-[300px] bg-glow-gold pointer-events-none -z-10"></div>

<div id="app" v-cloak class="max-w-7xl mx-auto min-h-screen flex flex-col justify-between relative z-10">
    
    <!-- Modal de Autenticación -->
    <div v-if="!isAuthenticated" class="fixed inset-0 z-[90] bg-[#03060f]/95 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="w-full max-w-xl bg-[#070e1e] border border-slate-800 rounded-2xl shadow-2xl p-6 md:p-8 text-center">
            <h2 class="text-2xl font-black text-white mb-2">Acceso a Soporte TIC</h2>
            <p class="text-slate-300 text-sm mb-2">Inicia sesión con tu cuenta institucional para mandar o gestionar avisos de incidencias.</p>
            <p class="text-sky-300 text-sm font-bold mb-6">Solo dominio autorizado: @sagrado-corazon.es</p>

            <div ref="googleLoginBtn" class="flex justify-center"></div>

            <p v-if="authError" class="mt-5 text-red-300 text-sm bg-red-950/30 border border-red-800/40 rounded-lg p-3">
                {{ authError }}
            </p>
        </div>
    </div>
    
    <div :class="!isAuthenticated ? 'pointer-events-none select-none blur-[2px]' : ''">
        <!-- Header Principal -->
        <header class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-[#070e1e]/90 p-5 rounded-2xl border border-slate-800/80 shadow-2xl backdrop-blur-md">
            <div class="flex items-center gap-4">
                <div class="relative w-16 h-16 flex-shrink-0 bg-[#040914] rounded-xl overflow-hidden flex items-center justify-center border border-slate-700 shadow-inner">
                    <img src="https://lh3.googleusercontent.com/u/0/d/1Y7DoPThxj9v0KH3ttMdoBh2cWKfgPe8Z" alt="Logo Sagrado Corazón" class="w-full h-full object-contain p-1" @error="handleLogoError" v-if="!logoFailed">
                    <div v-else class="w-full h-full bg-blue-600 text-white flex items-center justify-center p-2">
                        <i class="ph ph-desktop-tower text-3xl"></i>
                    </div>
                </div>
                <div>
                    <h1 class="text-xl md:text-2xl font-black text-white tracking-tight flex flex-wrap items-center gap-x-2">
                        <span>Centro Educativo</span>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-red-400 to-yellow-400">Sagrado Corazón</span>
                    </h1>
                    <p class="text-xs text-slate-400 font-semibold tracking-wide">Plataforma de Soporte e Intervenciones TIC</p>
                </div>
            </div>
            
            <div class="flex items-center gap-3 self-start md:self-auto">
                <div class="hidden lg:flex items-center gap-2 px-3 py-2 rounded-xl border border-sky-500/25 text-xs font-bold bg-sky-500/10 text-sky-200 shadow-md">
                    <i class="ph ph-user-circle text-base text-sky-300"></i>
                    <span class="truncate max-w-[200px]">{{ currentUserEmail }}</span>
                </div>

                <!-- Botón cambio de modo Docente / TIC -->
                <button v-if="isAdmin" type="button" @click="currentView = currentView === 'docente' ? 'tic' : 'docente'" class="px-4 py-2 rounded-xl border border-indigo-500/40 bg-indigo-500/20 text-indigo-200 text-xs font-bold hover:bg-indigo-500/30 transition shadow-lg flex items-center gap-2">
                    <i :class="currentView === 'tic' ? 'ph ph-user' : 'ph ph-wrench'"></i>
                    {{ currentView === 'tic' ? 'Ver Vista Docente' : 'Panel de Control TIC' }}
                </button>

                <button type="button" @click="logoutSession" class="px-3 py-2 rounded-xl border border-slate-700 bg-slate-800/60 text-slate-200 hover:bg-slate-700/80 text-xs font-bold transition shadow-lg flex items-center gap-1.5">
                    <i class="ph ph-sign-out"></i>
                    Salir
                </button>
            </div>
        </header>

        <!-- VISTA DOCENTE: Crear y seguir Avisos de Incidencia -->
        <div v-if="currentView === 'docente'" class="space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Formulario -->
                <div class="lg:col-span-1 bg-[#070e1e]/90 p-6 rounded-2xl shadow-xl border border-slate-800/80">
                    <h2 class="text-lg font-bold text-white mb-1 flex items-center gap-2">
                        <i class="ph ph-plus-circle text-blue-400 text-xl"></i> Nuevo Aviso TIC
                    </h2>
                    <p class="text-xs text-slate-400 mb-5">Genera una solicitud para resolver problemas informáticos o de aulas.</p>

                    <form @submit.prevent="submitTicket" class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-300 mb-1">Etapa Educativa</label>
                            <select v-model="newTicket.stage" required class="w-full text-xs border border-slate-700 rounded-xl p-3 bg-[#0d1b35] font-semibold text-slate-100 outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="Infantil">Infantil</option>
                                <option value="Primaria">Primaria</option>
                                <option value="ESO">ESO</option>
                                <option value="FP">Formación Profesional (FP)</option>
                                <option value="Otras">Otras / Dirección / Serv. Generales</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-300 mb-1">Lugar / Aula de la actuación</label>
                            <input type="text" v-model="newTicket.location" placeholder="Ej: Aula 102, Salón de Actos, Lab FP..." required class="w-full text-xs border border-slate-700 rounded-xl p-3 bg-[#0d1b35] font-semibold text-slate-100 outline-none focus:ring-2 focus:ring-blue-500">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-300 mb-1">Asunto / Problema breve</label>
                            <input type="text" v-model="newTicket.title" placeholder="Ej: Proyector no enciende, sin red WiFi..." required class="w-full text-xs border border-slate-700 rounded-xl p-3 bg-[#0d1b35] font-semibold text-slate-100 outline-none focus:ring-2 focus:ring-blue-500">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-300 mb-1">Descripción detallada</label>
                            <textarea v-model="newTicket.description" rows="4" placeholder="Explica detalles del fallo o si requiere intervención urgente..." class="w-full text-xs border border-slate-700 rounded-xl p-3 bg-[#0d1b35] font-semibold text-slate-100 outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                        </div>

                        <button type="submit" :disabled="isSubmitting" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs py-3 rounded-xl transition shadow-lg flex items-center justify-center gap-2">
                            <i v-if="isSubmitting" class="ph ph-spinner spinner text-base"></i>
                            <i v-else class="ph ph-paper-plane-tilt text-base"></i>
                            <span>{{ isSubmitting ? 'Enviando...' : 'Enviar Aviso al TIC' }}</span>
                        </button>
                    </form>
                </div>

                <!-- Lista de solicitudes del docente -->
                <div class="lg:col-span-2 bg-[#070e1e]/90 p-6 rounded-2xl shadow-xl border border-slate-800/80">
                    <h2 class="text-lg font-bold text-white mb-1 flex items-center gap-2">
                        <i class="ph ph-clock-counter-clockwise text-blue-400 text-xl"></i> Mis Solicitudes de Asistencia
                    </h2>
                    <p class="text-xs text-slate-400 mb-5">Estado actual y evolución de tus avisos enviados al TIC.</p>

                    <div v-if="myTickets.length === 0" class="text-center py-12 text-slate-500 text-sm">
                        No has registrado ningún aviso de incidencia aún.
                    </div>

                    <div v-else class="space-y-4 max-h-[600px] overflow-y-auto pr-1">
                        <div v-for="ticket in myTickets" :key="ticket.id" class="bg-[#040914] p-4 rounded-xl border border-slate-800 space-y-2">
                            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-2">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-black text-sky-400">{{ ticket.id }}</span>
                                    <span class="text-xs font-bold text-slate-300">{{ ticket.location }}</span>
                                    <span class="text-[10px] bg-slate-800 px-2 py-0.5 rounded text-slate-400 font-bold">{{ ticket.stage }}</span>
                                </div>
                                <span :class="getStatusBadgeClass(ticket.status)" class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase">
                                    {{ ticket.status }}
                                </span>
                            </div>

                            <h3 class="text-sm font-bold text-white">{{ ticket.title }}</h3>
                            <p class="text-xs text-slate-400">{{ ticket.description }}</p>

                            <div v-if="ticket.resolutionNotes" class="bg-blue-950/30 border-l-2 border-blue-500 p-2.5 rounded text-xs text-blue-200">
                                <strong>Nota del TIC:</strong> {{ ticket.resolutionNotes }}
                            </div>

                            <div class="text-[10px] text-slate-500 flex justify-between pt-1">
                                <span>Creado: {{ formatDate(ticket.createdAt) }}</span>
                                <span>Última actualización: {{ formatDate(ticket.updatedAt) }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- VISTA PANEL TIC (Solo Administradores y Equipo TIC) -->
        <div v-if="currentView === 'tic'" class="space-y-6">
            
            <!-- Resumen e Indicadores por Etapas -->
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                <div class="bg-[#070e1e] p-4 rounded-2xl border border-slate-800 text-center">
                    <p class="text-[11px] text-slate-400 font-bold uppercase">Total Avisos</p>
                    <p class="text-2xl font-black text-white mt-1">{{ filteredTickets.length }}</p>
                </div>
                <div class="bg-[#070e1e] p-4 rounded-2xl border border-slate-800 text-center">
                    <p class="text-[11px] text-amber-400 font-bold uppercase">Pendientes</p>
                    <p class="text-2xl font-black text-amber-300 mt-1">{{ countStatus('Pendiente') }}</p>
                </div>
                <div class="bg-[#070e1e] p-4 rounded-2xl border border-slate-800 text-center">
                    <p class="text-[11px] text-blue-400 font-bold uppercase">En Proceso</p>
                    <p class="text-2xl font-black text-blue-300 mt-1">{{ countStatus('En Proceso') }}</p>
                </div>
                <div class="bg-[#070e1e] p-4 rounded-2xl border border-slate-800 text-center">
                    <p class="text-[11px] text-emerald-400 font-bold uppercase">Resueltos</p>
                    <p class="text-2xl font-black text-emerald-300 mt-1">{{ countStatus('Resuelto') }}</p>
                </div>
                <div class="bg-[#070e1e] p-4 rounded-2xl border border-slate-800 text-center">
                    <p class="text-[11px] text-indigo-400 font-bold uppercase">Horas TIC</p>
                    <p class="text-2xl font-black text-indigo-300 mt-1">{{ (totalResolutionMinutes / 60).toFixed(1) }} h</p>
                </div>
                <div class="bg-[#070e1e] p-4 rounded-2xl border border-slate-800 text-center">
                    <p class="text-[11px] text-rose-400 font-bold uppercase">% Resp. TIC</p>
                    <p class="text-2xl font-black text-rose-300 mt-1">{{ ticResponsibilityPercent }}%</p>
                </div>
            </div>

            <!-- Desglose por Etapas Educativas -->
            <div class="bg-[#070e1e]/90 p-5 rounded-2xl border border-slate-800">
                <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-300 mb-3">Distribución por Etapas Colegio</h3>
                <div class="grid grid-cols-2 md:grid-cols-5 gap-3 text-xs">
                    <div v-for="(count, stage) in stageBreakdown" :key="stage" class="bg-[#040914] p-3 rounded-xl border border-slate-800 flex justify-between items-center">
                        <span class="font-bold text-slate-300">{{ stage }}</span>
                        <span class="font-black text-sky-400 bg-sky-950 px-2 py-0.5 rounded border border-sky-800">{{ count }}</span>
                    </div>
                </div>
            </div>

            <!-- Filtros de Actividad y Generación de Informes entre Fechas -->
            <div class="bg-[#070e1e]/90 p-5 rounded-2xl border border-slate-800 space-y-4">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="ph ph-funnel text-blue-400 text-lg"></i> Filtros de Consulta e Informes TIC
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" @click="exportReportCsv" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition shadow-md flex items-center gap-1.5">
                            <i class="ph ph-file-csv text-base"></i> Exportar CSV de Actuaciones
                        </button>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 text-xs">
                    <div>
                        <label class="block font-bold text-slate-400 mb-1">Fecha Desde:</label>
                        <input type="date" v-model="filters.dateFrom" class="w-full px-3 py-2 rounded-lg border border-slate-700 bg-[#040914] text-white outline-none">
                    </div>
                    <div>
                        <label class="block font-bold text-slate-400 mb-1">Fecha Hasta:</label>
                        <input type="date" v-model="filters.dateTo" class="w-full px-3 py-2 rounded-lg border border-slate-700 bg-[#040914] text-white outline-none">
                    </div>
                    <div>
                        <label class="block font-bold text-slate-400 mb-1">Etapa:</label>
                        <select v-model="filters.stage" class="w-full px-3 py-2 rounded-lg border border-slate-700 bg-[#040914] text-white outline-none">
                            <option value="">Todas</option>
                            <option value="Infantil">Infantil</option>
                            <option value="Primaria">Primaria</option>
                            <option value="ESO">ESO</option>
                            <option value="FP">FP</option>
                            <option value="Otras">Otras</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-bold text-slate-400 mb-1">Responsabilidad TIC:</label>
                        <select v-model="filters.responsibility" class="w-full px-3 py-2 rounded-lg border border-slate-700 bg-[#040914] text-white outline-none">
                            <option value="">Todas</option>
                            <option value="true">Responsabilidad del TIC</option>
                            <option value="false">No es del TIC</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-bold text-slate-400 mb-1">Buscador libre:</label>
                        <input type="text" v-model="filters.search" placeholder="Aula, docente, problema..." class="w-full px-3 py-2 rounded-lg border border-slate-700 bg-[#040914] text-white outline-none">
                    </div>
                </div>
            </div>

            <!-- Lista Completa de Avisos para Gestión TIC -->
            <div class="space-y-4">
                <div v-for="ticket in filteredTickets" :key="ticket.id" class="bg-[#070e1e] p-5 rounded-2xl border border-slate-800 space-y-4 shadow-xl">
                    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 border-b border-slate-800 pb-3">
                        <div class="flex items-center gap-3">
                            <span class="text-sm font-black text-sky-400">{{ ticket.id }}</span>
                            <span class="text-sm font-bold text-white">{{ ticket.location }}</span>
                            <span class="text-xs bg-slate-800 px-2.5 py-0.5 rounded-full text-slate-300 font-bold">{{ ticket.stage }}</span>
                            <span class="text-xs text-slate-400">Por: <strong>{{ ticket.requesterEmail }}</strong></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <select v-model="ticket.status" @change="saveTicketChanges(ticket)" class="text-xs font-bold border border-slate-700 rounded-lg py-1.5 px-3 bg-[#0d1b35] text-white cursor-pointer">
                                <option value="Pendiente">Pendiente</option>
                                <option value="En Proceso">En Proceso</option>
                                <option value="Resuelto">Resuelto</option>
                                <option value="Cancelado">Cancelado / No procede</option>
                            </select>

                            <button type="button" @click="sendNotificationMail(ticket)" class="px-3 py-1.5 bg-sky-600 hover:bg-sky-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1 shadow-sm">
                                <i class="ph ph-envelope"></i> Notificar Mail (Docente y Directora)
                            </button>
                        </div>
                    </div>

                    <div>
                        <h4 class="text-base font-bold text-white">{{ ticket.title }}</h4>
                        <p class="text-xs text-slate-300 mt-1">{{ ticket.description }}</p>
                    </div>

                    <!-- Ajustes de intervención TIC -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-[#040914] p-3.5 rounded-xl border border-slate-800 text-xs">
                        <div>
                            <label class="block font-bold text-slate-400 mb-1">¿Responsabilidad del TIC?</label>
                            <select v-model="ticket.isTicResponsibility" @change="saveTicketChanges(ticket)" class="w-full p-2 border border-slate-700 rounded bg-[#0d1b35] text-white font-bold">
                                <option :value="true">Sí (Incidencia técnica/informática)</option>
                                <option :value="false">No (Uso, infraestructura, otros)</option>
                            </select>
                        </div>

                        <div>
                            <label class="block font-bold text-slate-400 mb-1">Tiempo empleado (Minutos)</label>
                            <input type="number" min="0" step="5" v-model.number="ticket.resolutionTimeMinutes" @change="saveTicketChanges(ticket)" class="w-full p-2 border border-slate-700 rounded bg-[#0d1b35] text-white font-bold">
                        </div>

                        <div class="md:col-span-1">
                            <label class="block font-bold text-slate-400 mb-1">Notas / Diagnóstico TIC</label>
                            <input type="text" v-model="ticket.resolutionNotes" @change="saveTicketChanges(ticket)" placeholder="Comentarios de la solución..." class="w-full p-2 border border-slate-700 rounded bg-[#0d1b35] text-white font-medium">
                        </div>
                    </div>

                    <div class="text-[10px] text-slate-500 flex justify-between">
                        <span>Fecha solicitud: {{ formatDate(ticket.createdAt) }}</span>
                        <span>Historial de cambios: {{ ticket.history ? ticket.history.length : 0 }} registros</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <footer class="mt-8 border-t border-slate-800/80 py-4 text-center text-slate-500 text-xs font-semibold">
        <p>© 2026 Colegio Sagrado Corazón - Departamento de Tecnología de la Información y Comunicación (TIC)</p>
    </footer>
</div>

<script type="module">
    const URL_DEL_SCRIPT = "https://script.google.com/a/macros/sagrado-corazon.es/s/AKfycbw8Xmgj19NM5yJtGLR-VHbweVduMaQEP6Oq_3COXr3287CTnHJy7x4voSM8JUQ4aZV4/exec";

    const { createApp } = Vue;
    createApp({
        data() {
            return {
                isAuthenticated: false,
                currentUserEmail: '',
                isAdmin: false,
                authError: '',
                currentView: 'docente',
                googleClientId: '523053820797-pgh6mp7hagllp1cdhul8l5j2lulb78g2.apps.googleusercontent.com',
                institutionalDomain: 'sagrado-corazon.es',
                logoFailed: false,
                isSubmitting: false,
                tickets: [],
                newTicket: {
                    stage: 'ESO',
                    location: '',
                    title: '',
                    description: ''
                },
                filters: {
                    dateFrom: '',
                    dateTo: '',
                    stage: '',
                    responsibility: '',
                    search: ''
                }
            }
        },
        computed: {
            myTickets() {
                return this.tickets.filter(t => t.requesterEmail.toLowerCase() === this.currentUserEmail.toLowerCase());
            },
            filteredTickets() {
                return this.tickets.filter(t => {
                    if (this.filters.stage && t.stage !== this.filters.stage) return false;
                    if (this.filters.responsibility !== '') {
                        const boolVal = this.filters.responsibility === 'true';
                        if (t.isTicResponsibility !== boolVal) return false;
                    }
                    if (this.filters.dateFrom) {
                        if (new Date(t.createdAt) < new Date(this.filters.dateFrom + 'T00:00:00')) return false;
                    }
                    if (this.filters.dateTo) {
                        if (new Date(t.createdAt) > new Date(this.filters.dateTo + 'T23:59:59')) return false;
                    }
                    if (this.filters.search) {
                        const q = this.filters.search.toLowerCase();
                        const hay = `${t.title} ${t.location} ${t.description} ${t.requesterEmail}`.toLowerCase();
                        if (!hay.includes(q)) return false;
                    }
                    return true;
                });
            },
            stageBreakdown() {
                const map = { Infantil: 0, Primaria: 0, ESO: 0, FP: 0, Otras: 0 };
                this.filteredTickets.forEach(t => {
                    if (map[t.stage] !== undefined) map[t.stage]++;
                    else map['Otras']++;
                });
                return map;
            },
            totalResolutionMinutes() {
                return this.filteredTickets.reduce((sum, t) => sum + (t.resolutionTimeMinutes || 0), 0);
            },
            ticResponsibilityPercent() {
                if (this.filteredTickets.length === 0) return 0;
                const count = this.filteredTickets.filter(t => t.isTicResponsibility).length;
                return Math.round((count / this.filteredTickets.length) * 100);
            }
        },
        async mounted() {
            await this.initGoogleAuth();
        },
        methods: {
            handleLogoError() { this.logoFailed = true; },
            formatDate(isoStr) {
                if (!isoStr) return '';
                return new Date(isoStr).toLocaleString('es-ES');
            },
            getStatusBadgeClass(status) {
                if (status === 'Pendiente') return 'bg-amber-500/20 text-amber-300 border border-amber-500/40';
                if (status === 'En Proceso') return 'bg-blue-500/20 text-blue-300 border border-blue-500/40';
                if (status === 'Resuelto') return 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40';
                return 'bg-slate-800 text-slate-400 border border-slate-700';
            },
            countStatus(status) {
                return this.filteredTickets.filter(t => t.status === status).length;
            },
            parseJwt(token) {
                try {
                    return JSON.parse(atob(token.split('.')[1]));
                } catch (e) { return null; }
            },
            async initGoogleAuth() {
                const saved = localStorage.getItem('sc_tic_token');
                if (saved) {
                    const payload = this.parseJwt(saved);
                    if (payload && payload.email && payload.email.endsWith('@' + this.institutionalDomain)) {
                        this.currentUserEmail = payload.email.toLowerCase();
                        this.isAuthenticated = true;
                        this.isAdmin = this.currentUserEmail.startsWith('tic@') || this.currentUserEmail.startsWith('fp@');
                        if (this.isAdmin) this.currentView = 'tic';
                        this.loadData();
                        return;
                    }
                }
                await this.$nextTick();
                this.renderGoogleBtn();
            },
            renderGoogleBtn() {
                if (!this.$refs.googleLoginBtn || !window.google) return;
                window.google.accounts.id.initialize({
                    client_id: this.googleClientId,
                    callback: (res) => {
                        const payload = this.parseJwt(res.credential);
                        if (payload && payload.email && payload.email.endsWith('@' + this.institutionalDomain)) {
                            localStorage.setItem('sc_tic_token', res.credential);
                            this.currentUserEmail = payload.email.toLowerCase();
                            this.isAuthenticated = true;
                            this.isAdmin = this.currentUserEmail.startsWith('tic@') || this.currentUserEmail.startsWith('fp@');
                            if (this.isAdmin) this.currentView = 'tic';
                            this.loadData();
                        } else {
                            this.authError = 'Debes acceder con una cuenta corporativa @sagrado-corazon.es';
                        }
                    }
                });
                window.google.accounts.id.renderButton(this.$refs.googleLoginBtn, {
                    theme: 'filled_black', size: 'large', width: 320
                });
            },
            logoutSession() {
                localStorage.removeItem('sc_tic_token');
                this.isAuthenticated = false;
                this.currentUserEmail = '';
                this.$nextTick(() => this.renderGoogleBtn());
            },
            async loadData() {
                try {
                    const res = await fetch(URL_DEL_SCRIPT + '?idToken=' + localStorage.getItem('sc_tic_token'));
                    const json = await res.json();
                    if (json.success) {
                        this.tickets = json.tickets || [];
                    }
                } catch (e) {
                    console.error('Error cargando avisos:', e);
                }
            },
            async submitTicket() {
                this.isSubmitting = true;
                try {
                    const token = localStorage.getItem('sc_tic_token');
                    const res = await fetch(URL_DEL_SCRIPT, {
                        method: 'POST',
                        body: JSON.stringify({
                            idToken: token,
                            action: 'create_ticket',
                            ticket: { ...this.newTicket }
                        })
                    });
                    const json = await res.json();
                    if (json.success) {
                        this.tickets = json.tickets;
                        this.newTicket = { stage: 'ESO', location: '', title: '', description: '' };
                        alert('Aviso enviado correctamente al Departamento TIC.');
                    } else {
                        alert('Error: ' + json.error);
                    }
                } catch (e) {
                    alert('Error en la comunicación con el servidor.');
                } finally {
                    this.isSubmitting = false;
                }
            },
            async saveTicketChanges(ticket) {
                try {
                    const token = localStorage.getItem('sc_tic_token');
                    await fetch(URL_DEL_SCRIPT, {
                        method: 'POST',
                        body: JSON.stringify({
                            idToken: token,
                            action: 'update_ticket',
                            ticket: ticket
                        })
                    });
                } catch (e) {
                    console.error('Error al guardar cambios del aviso:', e);
                }
            },
            async sendNotificationMail(ticket) {
                if (!confirm(`¿Enviar email de actualización a ${ticket.requesterEmail} y a Dirección?`)) return;
                try {
                    const token = localStorage.getItem('sc_tic_token');
                    const res = await fetch(URL_DEL_SCRIPT, {
                        method: 'POST',
                        body: JSON.stringify({
                            idToken: token,
                            action: 'notify_status_update',
                            ticket: ticket
                        })
                    });
                    const json = await res.json();
                    if (json.success) {
                        alert('Notificación por correo enviada con éxito.');
                    } else {
                        alert('Error enviando notificación: ' + json.error);
                    }
                } catch (e) {
                    alert('No se pudo enviar el correo.');
                }
            },
            exportReportCsv() {
                const rows = this.filteredTickets;
                if (rows.length === 0) {
                    alert('No hay actuaciones para exportar en este filtro.');
                    return;
                }
                const headers = ['ID', 'Fecha', 'Etapa', 'Lugar', 'Solicitante', 'Asunto', 'Estado', 'Responsabilidad TIC', 'Minutos Invertidos', 'Notas TIC'];
                const csvLines = [headers.join(',')];

                rows.forEach(t => {
                    const line = [
                        `"${t.id}"`,
                        `"${this.formatDate(t.createdAt)}"`,
                        `"${t.stage}"`,
                        `"${t.location.replace(/"/g, '""')}"`,
                        `"${t.requesterEmail}"`,
                        `"${t.title.replace(/"/g, '""')}"`,
                        `"${t.status}"`,
                        `"${t.isTicResponsibility ? 'Sí' : 'No'}"`,
                        `"${t.resolutionTimeMinutes || 0}"`,
                        `"${(t.resolutionNotes || '').replace(/"/g, '""')}"`
                    ];
                    csvLines.push(line.join(','));
                });

                const blob = new Blob(['\ufeff' + csvLines.join('\n')], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `informe_actuaciones_tic_${new Date().toISOString().slice(0, 10)}.csv`;
                a.click();
            }
        }
    }).mount('#app');
</script>
</body>
</html>
